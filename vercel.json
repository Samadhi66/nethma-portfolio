{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {"source":"/projects","destination":"/projects/index.html"},
    {"source":"/experience","destination":"/experience/index.html"},
    {"source":"/expertise","destination":"/expertise/index.html"},
    {"source":"/about","destination":"/about/index.html"},
    {"source":"/contact","destination":"/contact/index.html"},
    {
      "source": "/projects/finai",
      "destination": "/projects/finai/index.html"
    },
    {
      "source": "/projects/ayurvedic-medicine",
      "destination": "/projects/ayurvedic-medicine/index.html"
    },
    {
      "source": "/projects/library-management",
      "destination": "/projects/library-management/index.html"
    },
    {
      "source": "/projects/cleaning-service",
      "destination": "/projects/cleaning-service/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "trailingSlash": false
}
